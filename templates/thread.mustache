{{!
    One forum discussion card.
    @template report_forumtriage/thread
}}
<div class="card mb-2">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start">
            <div class="mr-3">
                <h4 class="h5 mb-1"><a href="{{url}}">{{subject}}</a></h4>
                <div class="small text-muted">
                    {{forumlabel}}{{#hasgroup}} · {{grouplabel}}{{/hasgroup}}
                </div>
            </div>
            <span class="badge {{priorityclass}}">{{prioritytext}}</span>
        </div>

        <div class="mt-2 small">
            <span class="mr-3">{{replieslabel}}</span>
            <span class="mr-3">{{authorslabel}}</span>
            <span class="mr-3">{{lastactivitylabel}}</span>
            {{#teacherresponded}}<span class="badge badge-success">{{#str}}
                teacherreplied, report_forumtriage{{/str}}</span>{{/teacherresponded}}
            {{#noteacherresponded}}<span class="badge badge-light">{{#str}}
                noteacherreply, report_forumtriage{{/str}}</span>{{/noteacherresponded}}
        </div>

        {{#hasanalysis}}
            <div class="mt-2">
                {{#topic}}<strong>{{topic}}</strong>{{/topic}}
                {{#summary}}
                    <div>{{summary}}</div>{{/summary}}
                {{#reason}}
                    <div class="small text-muted">{{reason}}</div>{{/reason}}
                {{#confidencelabel}}
                    <div class="small text-muted">{{confidencelabel}}</div>{{/confidencelabel}}
            </div>
        {{/hasanalysis}}

        <div class="mt-2">
            <a class="btn btn-sm btn-secondary" href="{{url}}">{{#str}}opendiscussion, report_forumtriage{{/str}}</a>
        </div>
    </div>
</div>
